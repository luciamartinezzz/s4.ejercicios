def sort_array(array):
    resultado = array[:]

    for i in range(len(resultado)):
        for j in range(len(resultado) - 1 - i):
            if resultado[j] > resultado[j + 1]:
                resultado[j], resultado[j + 1] = resultado[j + 1], resultado[j]

    return resultado

def elementwise_array_sum(a, b):
    resultado = []

    for i in range(len(a)):
        resultado.append(a[i] + b[i])

    return resultado

def matrix_sum(a, b):
    resultado = []

    for i in range(len(a)):
        fila = []

        for j in range(len(a[i])):
            fila.append(a[i][j] + b[i][j])

        resultado.append(fila)

    return resultado

def calcular_coste(nombres, cantidades, precios):
    total = 0

    for i in range(len(nombres)):
        coste = cantidades[i] * precios[i]
        total += coste

        print(nombres[i], ":", cantidades[i],
              "edificios =", coste, "euros")
    return total

def comprobar_dependencias(nombres, cantidades):
    almacenes = 0
    escuelas = 0

    for i in range(len(nombres)):
        if nombres[i] == "warehouse":
            almacenes += cantidades[i]

        if nombres[i] == "school":
            escuelas += cantidades[i]

    if escuelas > 0 and almacenes == 0:
        print("Error: no se pueden construir escuelas sin almacen")
        return False

    return True

def comprobar_recursos(recursos, necesarios):
    for i in range(len(recursos)):
        if necesarios[i] > recursos[i]:
            print("No hay recursos suficientes")
            return False

    return True

def calcular_recursos(cantidades, materiales):
    total = [0, 0, 0]

    for i in range(len(cantidades)):
        for j in range(3):
            total[j] += cantidades[i] * materiales[i][j]

    return total

def crear_obras(nombres, cantidades, horas):
    obras = []

    for i in range(len(nombres)):
        for j in range(cantidades[i]):
            obras.append([nombres[i], horas[i]])

    return obras

