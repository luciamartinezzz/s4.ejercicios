import resource_management as rm


def main():

    print("PARTE I: ADMINISTRACION DE RECURSOS")

    wood = [20, 15, 30, 10]
    stone = [25, 10, 20, 5]
    money = [200, 150, 300, 100]

    print("\n1. ORDENAR RECURSOS")

    sorted_wood = rm.sort_array(wood)
    sorted_stone = rm.sort_array(stone)
    sorted_money = rm.sort_array(money)

    print("Madera:", sorted_wood)
    print("Piedra:", sorted_stone)
    print("Dinero:", sorted_money)

    print("\n2. SUMAR ARRAYS")

    total_recursos = rm.elementwise_array_sum(
        sorted_wood,
        rm.elementwise_array_sum(sorted_stone, sorted_money)
    )

    print("Recursos sumados:", total_recursos)

    print("\n3. SUMAR MATRICES")

    house_cost = [[10, 5, 30], [5, 15, 10], [25, 5, 5]]
    school_cost = [[20, 25, 10], [15, 20, 20], [10, 15, 30]]
    subsidy = [[5, 5, 5], [5, 5, 5], [5, 5, 5]]

    print("Coste casas:", rm.matrix_sum(house_cost, subsidy))
    print("Coste escuelas:", rm.matrix_sum(school_cost, subsidy))

    print("\n4. PROYECTO DE CONSTRUCCION")

    nombres = ["warehouse", "house", "school"]
    cantidades = [1, 3, 2]
    precios = [300, 200, 500]

    materiales = [
        [10, 10, 50],
        [15, 10, 30],
        [20, 15, 60]
    ]

    recursos_disponibles = [200, 150, 1000]

    if rm.comprobar_dependencias(nombres, cantidades):

        necesarios = rm.calcular_recursos(cantidades, materiales)

        print("Recursos necesarios:", necesarios)

        if rm.comprobar_recursos(recursos_disponibles, necesarios):

            coste = rm.calcular_coste(nombres, cantidades, precios)

            print("Coste total:", coste, "euros")

            print("\nPARTE II: SIMULACION DE TIEMPO")

            horas_por_edificio = [30, 20, 40]

            obras = rm.crear_obras(
                nombres,
                cantidades,
                horas_por_edificio
            )

            print("Numero total de construcciones:", len(obras))

            for obreros in [4, 8, 12]:

                print("\nSIMULACION CON", obreros, "OBREROS")

                tiempo1 = rm.simular_construccion(
                    obras, obreros, 1
                )

                tiempo2 = rm.simular_construccion(
                    obras, obreros, 2
                )

                tiempo3 = rm.simular_construccion(
                    obras, obreros, 3, 2
                )

                print("Reparto equitativo:", tiempo1, "horas")
                print("Una obra a la vez:", tiempo2, "horas")
                print("Grupos de 2:", tiempo3, "horas")


main()
